# Frontend environment variables configuration
# Prepend with REACT_APP_ so react-scripts can access them during build

# URL of the backend node server (e.g. your Render Web Service URL)
# If left blank, it automatically falls back to window.location (port 3001) for local networks
REACT_APP_SERVER_URL=https://endplays-quiz-server.onrender.com

# URL of the frontend app (e.g. your Vercel or custom domain deployment)
# If left blank, it automatically falls back to window.location.origin (perfect for both local network and dynamic deployment domains)
REACT_APP_CLIENT_URL=https://endplays-quiz.vercel.app
